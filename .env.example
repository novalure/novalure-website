NEXT_PUBLIC_SITE_URL=https://www.novalure.eu
# Optional local DOI origin when the development server does not run on 3000.
# It must be an explicit localhost origin, for example http://localhost:3001.
PLAYBOOK_DEVELOPMENT_ORIGIN=http://localhost:3000

NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-29
SANITY_API_READ_TOKEN=

HUBSPOT_PORTAL_ID=your_hubspot_portal_id
HUBSPOT_PLAYBOOK_FORM_GUID=
HUBSPOT_DEVELOPER_FORM_GUID=
HUBSPOT_AGENT_FORM_GUID=
NEXT_PUBLIC_HUBSPOT_REGION=eu1
NEXT_PUBLIC_HUBSPOT_MEETING_URL=https://meetings-eu1.hubspot.com/franz-romih
NEXT_PUBLIC_HUBSPOT_MEETING_URL_EN=https://meetings-eu1.hubspot.com/franz-romih/private-growth-audit-en
NEXT_PUBLIC_HUBSPOT_MEETING_URL_DE=https://meetings-eu1.hubspot.com/franz-romih
# TODO(es-meeting): Replace this fallback with a dedicated Spanish meeting type once one is available.
# Until then the ES scheduler intentionally reuses the EN meeting type and adds locale=es-es.
NEXT_PUBLIC_HUBSPOT_MEETING_URL_ES=https://meetings-eu1.hubspot.com/franz-romih/private-growth-audit-en
NEXT_PUBLIC_HUBSPOT_TRACKING_CODE_ID=
# Legacy public HubSpot names are still accepted by the API route during migration:
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_DEVELOPER_FORM_ID=
NEXT_PUBLIC_HUBSPOT_AGENT_FORM_ID=

RESEND_API_KEY=
# At least 32 bytes of high-entropy secret material.
DOUBLE_OPT_IN_SECRET=
# Optional during an intentional signing-key rotation. Never configure this
# without also configuring DOUBLE_OPT_IN_SECRET.
DOUBLE_OPT_IN_PREVIOUS_SECRET=
RESEND_CONTACT_SEGMENT_ID=
RESEND_MARKETING_TOPIC_ID=
CONTACT_SENDER_EMAIL=hello@novalure.eu
CONTACT_BOOKING_URL=https://meetings-eu1.hubspot.com/franz-romih
CONTACT_BOOKING_URL_EN=https://meetings-eu1.hubspot.com/franz-romih/private-growth-audit-en
CONTACT_BOOKING_URL_DE=https://meetings-eu1.hubspot.com/franz-romih
RESEND_FROM_EMAIL=Novalure <playbooks@novalure.eu>
DEVELOPER_PLAYBOOK_URL=
AGENT_PLAYBOOK_URL=
DEVELOPER_PLAYBOOK_URL_EN=
DEVELOPER_PLAYBOOK_URL_DE=
DEVELOPER_PLAYBOOK_URL_ES=
AGENT_PLAYBOOK_URL_EN=
AGENT_PLAYBOOK_URL_DE=
AGENT_PLAYBOOK_URL_ES=

# Canonical pair injected automatically by the Vercel Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative pair for a directly managed/local Upstash connection. The
# Vercel-injected KV pair takes precedence when both complete pairs exist.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
